Del archivo general de alumnos de la U.T.N. - Facultad Regional Resistencia, ordenado por carrera,
se desea emitir la cantidad de alumnos correspondientes a cada carrera y el total general.

ACCION ejercicio2_2_10 ES
  AMBIENTE
    fecha = registro
      dd: 1..31;
      mm: 1..12;
      aa: N(4);
    fr;

    alumno = registro
      AyN: AN(40);
      carrera: ("ISI","IEM",IQ");
      legajo: N(7);
      fecha_nacimiento: fecha;
      fecha_ingreso: fecha;
      dni: N(8);
      sexo: ("M","F");
      fecha_ultimo_examen_aprobado: fecha;
      nota: N(2);
    fr;

alumnos: archivo de alumno ordenado por carrera;
reg: alumno;

SUBACCION ver_corte ES
  SI (actual_carrera <> reg.carrera) ENTONCES
    corte_carrera;
  FS
FS;

SUBACCION corte_carrera ES
  ESC("La cantidad de alumnos correspondientes a la carrera de: ", actual_carrera, "son: ", total_carrera);
  total_general:= total_general + total_carrera;  // acumulo en nivel superior inmediato
  total_carrera:= 0;  // reinicio contador
  actual_carrera:= reg.carrera; // actualizo variable control
FS;

SUBACCION tratar_registro ES
  total_carrera:= total_carrera + 1;  // sumno alumnos de una carrera
FS;

SUBACCION emitir_total ES
  ESC("El total de alumnos en la UTN es de: ", total_general);
FS;
  
actual_carrera: ("ISI","IEM",IQ");
total_carrera: N(4);
total_general: N(5);

PROCESO

  total_carrera, total_general:= 0;
  ABRIR E/(alumnos);
  LEER(alumnos, reg);
  actual_carrera:= reg.carrera;
  MIENTRAS NFDA(alumnos) HACER
    ver_corte;
    tratar_registro;
    LEER(alumnos, reg);
  FM;
  corte_carrera;
  emitir_total;
  CERRAR(alumnos);

FIN_ACCION;
  





